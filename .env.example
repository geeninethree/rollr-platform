# Copy to .env.local for local dev. Set the same keys in Vercel → Environment Variables.

# Public site URL (metadata, email links)
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key_here

# Admin UI (/admin): set in Supabase (required for data access):
#   update public.profiles set is_admin = true where email = 'you@example.com';
# Server-only admin notify list (do NOT use NEXT_PUBLIC_ for admin emails):
# ADMIN_EMAILS=you@example.com

# Optional Resend (https://resend.com) — without these, all email is a silent no-op:
#   • New brief → creator email (POST /api/notify/brief)
#   • New waitlist → admin emails (POST /api/notify/waitlist)
# Waitlist users do NOT get auto-confirm emails (review in /admin).
# RESEND_API_KEY=re_...
# EMAIL_FROM=ROLLR <onboarding@resend.dev>
