# Copy to .env.local for local dev. Set the same keys in Vercel → Environment Variables for production.

# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key_here

# Comma-separated emails that can open /admin (fallback if profiles.is_admin not set)
# NEXT_PUBLIC_ADMIN_EMAILS=you@example.com

# Optional: email creators on new brief (https://resend.com)
# RESEND_API_KEY=re_...
# EMAIL_FROM=ROLLR <onboarding@resend.dev>
